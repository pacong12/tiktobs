# TikTobs configuration template.
# Copy this file to `.env` (same folder) and adjust. The real environment
# always takes precedence over .env values.

# --- TikTok LIVE connection -----------------------------------------------
# Sign API key used by the TikTokLive provider. Leave empty if unused.
TIKTOK_SIGN_API_KEY=

# --- API authentication (optional, off by default) ------------------------
# When set, every /api/* route and the /ws WebSocket requires the token via
# header `X-API-Token: <token>` or query `?token=<token>`. Leave empty to
# disable (recommended only for single-user local use).
TIKTOBS_API_TOKEN=

# --- Simulated test endpoints (/api/test/*) --------------------------------
# Production-safe default: disabled. Set to 1 to enable the simulation
# buttons in Poll Admin and the /api/test/* endpoints.
TIKTOBS_TEST_ENDPOINTS=0

# --- Event retention -------------------------------------------------------
# Events older than this many days are purged at startup and hourly.
# Set to 0 (or negative) to keep events forever.
TIKTOBS_RETENTION_DAYS=7

# --- Server binding ---------------------------------------------------------
# HOST/PORT for `python run_app.py`.
TIKTOBS_HOST=127.0.0.1
TIKTOBS_PORT=8000
